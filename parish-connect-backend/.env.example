APP_NAME=ParishConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,https://parish-connect-kb48.vercel.app
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parish_connect
DB_USERNAME=root
DB_PASSWORD=
# For Aiven on Render (path inside backend Docker container):
# MYSQL_ATTR_SSL_CA=/var/www/html/certs/ca.pem
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MIGRATE_ON_START=false
# Optional, only needed if you manually run StaffSeeder:
# INITIAL_STAFF_PASSWORD=
# ONLY for one-time initial priest account setup (after migrations):
BOOTSTRAP_PRIEST_ON_START=false
# INITIAL_PRIEST_NAME=Parish Priest
# INITIAL_PRIEST_EMAIL=priest@example.org
# INITIAL_PRIEST_PASSWORD=use-a-unique-strong-password-here
