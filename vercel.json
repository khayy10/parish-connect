{
  "buildCommand": "cd parish-connect-frontend && npm run build",
  "outputDirectory": "parish-connect-frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://parish-connect-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "cd parish-connect-frontend && npm ci"
}
